prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${pcfiledir}/../../lib
includedir=${pcfiledir}/../../include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.9.100
Requires: libswscale >= 9.3.100, libavformat >= 62.6.100, libavcodec >= 62.15.100, libswresample >= 6.2.100, libavutil >= 60.13.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -pthread -lm -framework VideoToolbox -framework CoreFoundation -framework CoreMedia -framework CoreVideo
Libs.private: 
Cflags: -I${includedir}
