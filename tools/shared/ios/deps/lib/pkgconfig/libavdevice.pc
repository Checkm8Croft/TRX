prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${pcfiledir}/../../lib
includedir=${pcfiledir}/../../include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.2.100
Requires: libavfilter >= 11.9.100, libswscale >= 9.3.100, libavformat >= 62.6.100, libavcodec >= 62.15.100, libswresample >= 6.2.100, libavutil >= 60.13.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavdevice -framework Foundation -lm -framework AVFoundation -framework CoreVideo -framework CoreMedia -pthread
Libs.private: 
Cflags: -I${includedir}
