#!/bin/sh
# Wrapper: points pkg-config at the vendored iOS dependency .pc files
# shipped alongside this script (tools/shared/ios/deps/lib/pkgconfig),
# instead of any developer's personal machine paths. Self-locates so it
# works regardless of where the repo is checked out.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export PKG_CONFIG_LIBDIR="$SCRIPT_DIR/deps/lib/pkgconfig"
export PKG_CONFIG_PATH=
exec pkg-config "$@"
